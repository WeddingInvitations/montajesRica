# Opciones locales. Flask carga este archivo al copiarlo como .env.
# true conecta con datos REALES: editar desde localhost también modifica Firestore.
APP_ENV=development
USE_FIRESTORE=false
GOOGLE_CLOUD_PROJECT=montajesrica
FIREBASE_PROJECT_ID=montajesrica
# En local, guarda estos valores en .env (ignorado por Git), nunca en el repositorio.
FLASK_SECRET_KEY=
FLASK_SECRET_NAME=montajes-rica-flask-secret
