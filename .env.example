# Local defaults use the clearly marked demo dataset in data/club.json.
APP_ENV=development
USE_FIRESTORE=false
GOOGLE_CLOUD_PROJECT=
REQUIRE_IAP=false
LOCAL_AUTH_BYPASS=false
# En local, guarda estos valores en .env (ignorado por Git), nunca en el repositorio.
FLASK_SECRET_KEY=
FLASK_SECRET_NAME=montajes-rica-flask-secret
# Opcional: usa esta audiencia fija solo en pruebas locales de IAP.
IAP_AUDIENCE=
